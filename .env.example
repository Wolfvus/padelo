APP_ENV=development
PORT=8080
DATABASE_URL=postgres://padelo:padelo@127.0.0.1:5432/padelo?sslmode=disable
PUBLIC_ORIGIN=http://127.0.0.1:8080
WEB_ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_TTL_HOURS=12

# Optional. If TELEGRAM_WEBHOOK_SECRET is set, TELEGRAM_ALLOWED_CHAT_IDS is mandatory.
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_IDS=

# Leave false unless requests can only reach the app through Cloudflare.
TRUST_CLOUDFLARE_IP=false
